# Greenatics Huella staging on the existing greenatics-ops Supabase project.
# Copy these values only to the runtime host's private environment. Never commit secrets.
APP_ENV=staging
DATABASE_URL=postgresql+psycopg://postgres.dokxiyyypqbpilfivxse:REEMPLAZAR_PASSWORD_SUPABASE@aws-0-ca-central-1.pooler.supabase.com:5432/postgres
DATABASE_SCHEMA=huella

SESSION_SECRET=REEMPLAZAR_CON_SECRETO_ALEATORIO_DE_64_CARACTERES
SESSION_HTTPS_ONLY=true
PUBLIC_BASE_URL=https://huella.greenatics.com.co
GREENATICS_PUBLIC_URL=https://greenatics-circular.arendon.chatgpt.site
TRUSTED_HOSTS=huella.greenatics.com.co

# A staging environment may use seeded demonstration data, never real customer data.
SEED_DEMO=true
BOOTSTRAP_ADMIN_EMAIL=REEMPLAZAR_ADMIN@greenatics.com.co
BOOTSTRAP_ADMIN_PASSWORD=REEMPLAZAR_CONTRASENA_INICIAL
BOOTSTRAP_ORGANIZATION="Greenatics - Staging"

# Real persistent object storage is required before production certification.
STORAGE_BACKEND=s3
S3_BUCKET=REEMPLAZAR_BUCKET_PRIVADO
S3_ENDPOINT_URL=REEMPLAZAR_ENDPOINT_S3
S3_REGION=us-east-1
S3_ACCESS_KEY=REEMPLAZAR_ACCESS_KEY
S3_SECRET_KEY=REEMPLAZAR_SECRET_KEY

CSRF_ENABLED=true
STRUCTURED_LOGGING=true
AUDIT_CHAIN_ENABLED=true
DEPLOYMENT_STRICT=true
METRICS_TOKEN=REEMPLAZAR_TOKEN_ALEATORIO
ALERT_WEBHOOK_SECRET=REEMPLAZAR_SECRETO_ALEATORIO
ALERT_ORGANIZATION_ID=1
