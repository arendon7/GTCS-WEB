# Local-only values for docker-compose.yml. Never reuse this file for staging or production.
RED_DB_PASSWORD=red-local-only-change-me
RED_PORT=8787
SESSION_SECRET=local-compose-only-replace-before-any-shared-environment
SESSION_COOKIE_NAME=greenatics_red_session
SESSION_HTTPS_ONLY=false
PUBLIC_BASE_URL=http://127.0.0.1:8787
TRUSTED_HOSTS=localhost,127.0.0.1
RED_STORAGE_ROOT=/var/data/red/private
STORAGE_BACKEND=filesystem
RED_MAX_UPLOAD_MB=20
RED_MAX_EVIDENCE_TOTAL_MB=1024
RED_MAX_EVIDENCE_PROJECT_MB=256
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8787/drive/callback
TOKEN_ENCRYPTION_KEY=
RED_OPERATIONAL_WRITES_ENABLED=false
