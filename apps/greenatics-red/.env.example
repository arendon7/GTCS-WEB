# Local development. For a hosted environment, use the platform secret manager.
APP_ENV=local
INSTANCE_DIR=./instance/local-dev
DATABASE_URL=sqlite:///./instance/local-dev/greenatics_red.sqlite3
DATABASE_SCHEMA=
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
SESSION_COOKIE_NAME=greenatics_red_session
SESSION_HTTPS_ONLY=false
TRUSTED_HOSTS=localhost,127.0.0.1
# Only configure on Render's Cloudflare edge; leave blank for local development.
TRUSTED_CLIENT_IP_HEADER=
PUBLIC_BASE_URL=http://127.0.0.1:8787
STORAGE_BACKEND=local
RED_STORAGE_ROOT=./instance/local-dev/private
RED_MAX_UPLOAD_MB=20
# Aggregate private evidence caps. Tune to the dedicated RED storage capacity.
RED_MAX_EVIDENCE_TOTAL_MB=1024
RED_MAX_EVIDENCE_PROJECT_MB=256

# For an S3-compatible hosted environment, set STORAGE_BACKEND=s3 and configure
# the private RED bucket in the hosting secret manager (never in browser code).
# S3_BUCKET=
# S3_ENDPOINT_URL=
# S3_REGION=us-east-1
# S3_ACCESS_KEY=
# S3_SECRET_KEY=

# Dedicated RED PostgreSQL database on the Greenatics hosting platform.
# Keep DATABASE_SCHEMA empty in staging/production; RED fails before migrations
# when a shared-schema configuration is present. A schema may be used only for
# isolated local migration/QA work.
# DATABASE_URL=postgresql://...
# Hosted migrations also require an opaque reference to archived verification
# that DATABASE_URL points to a database dedicated to RED.
RED_DATABASE_ISOLATION_REFERENCE=

# Optional until the Google OAuth web client is created for the RED runtime.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8787/drive/callback
# Generate once with: python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
TOKEN_ENCRYPTION_KEY=

# Closed by default in every environment. Only set true for deliberate local QA
# with synthetic data or for a specifically approved supervised environment.
RED_PUBLIC_ACCESS_ENABLED=false
RED_OPERATIONAL_WRITES_ENABLED=false
RED_PRIVACY_APPROVED=false
RED_SUPERVISED_PILOT_APPROVED=false
# In staging/production, true also requires an opaque reference to each archived
# approval. Never place approval URLs, names, or personal data in these values.
RED_PRIVACY_APPROVAL_REFERENCE=
RED_SUPERVISED_PILOT_APPROVAL_REFERENCE=
# Add the exact HTTPS website origins only after the public-access gate is approved.
# RED_PUBLIC_SITE_ORIGINS=https://greenatics.co,https://www.greenatics.co
