{
  "name": "greenatics-public-web",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:lan": "next dev --hostname 0.0.0.0 --port 3001",
    "build": "next build --webpack",
    "build:sites-preview": "node scripts/build-sites-preview.mjs",
    "postbuild": "node scripts/normalize-static-export.mjs",
    "start": "next start",
    "check": "tsc --noEmit",
    "audit:static": "node scripts/audit-static.mjs",
    "qa:asset-rights-source": "node scripts/audit-source-asset-rights.mjs",
    "test:audit-copy": "node --test tests/audit-static-copy-markers.test.mjs",
    "test:asset-rights": "node --test tests/public-asset-rights-gate.test.mjs",
    "test:document-quality": "node --test tests/public-document-quality-gate.test.mjs",
    "test:review-routes": "node --test tests/public-review-route-gate.test.mjs",
    "qa:public-output": "node scripts/check-public-output.mjs",
    "package:sites": "node scripts/package-sites-export.mjs",
    "qa:runtime-config": "node scripts/check-runtime-config.mjs",
    "qa:runtime-preflight": "node scripts/check-runtime-preflight.mjs",
    "qa:ecosystem": "node scripts/check-local-ecosystem.mjs",
    "qa:entrypoints": "node scripts/check-local-entrypoints.mjs",
    "test:local-http-checks": "node --test tests/local-http-checks.test.mjs",
    "qa:tool-contracts": "node scripts/check-tool-contracts.mjs",
    "test:tool-contracts": "node --test tests/check-tool-contracts.test.mjs",
    "test:visual": "playwright test tests/visual-smoke.spec.ts",
    "test:a11y": "playwright test tests/accessibility.spec.ts",
    "test:casa-jardin": "playwright test tests/casa-jardin-content.spec.ts",
    "test:wondergreen": "playwright test tests/wondergreen-catalog.spec.ts tests/wondergreen-catalog-contract.spec.ts",
    "test:tool-hub": "playwright test tests/tool-hub.spec.ts",
    "test:red-readiness": "node --test tests/red-readiness.test.mjs",
    "test:local-tool-runtime": "playwright test tests/local-tool-runtime.spec.ts",
    "test:red": "playwright test tests/red-app.spec.ts"
  },
  "dependencies": {
    "next": "^16.4.1",
    "react": "^19.2.9",
    "react-dom": "^19.2.9"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.3",
    "@playwright/test": "^1.62.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.9.0"
  }
}
