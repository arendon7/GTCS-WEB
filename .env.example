# GREENATICS OPS data backend.
# Local is the safe default for development, CI and isolated demos.
NEXT_PUBLIC_DATA_MODE=local

# Required when NEXT_PUBLIC_DATA_MODE=supabase.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Hosted pilot only. Server-side secret used for Auth Admin invitations/listing.
# Use the current Supabase secret key (sb_secret_...). NEVER prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Canonical public origin of the internal app, without trailing slash.
# Example: https://ops.greenatics.com.co
APP_BASE_URL=

# Never commit real credentials or expose SUPABASE_SECRET_KEY to browser code.
