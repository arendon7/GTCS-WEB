# GREENATICS platform data backend.
# Local is the safe default for development, CI and isolated demos.
NEXT_PUBLIC_DATA_MODE=local

# Required when NEXT_PUBLIC_DATA_MODE=supabase.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Hosted pilot only. Server-side secret used for Supabase Auth Admin operations.
# Use the current Supabase secret key. NEVER prefix it with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Canonical public origin of the deployed platform, without trailing slash.
# Example: https://greenatics.com.co or https://ops.greenatics.com.co
APP_BASE_URL=

# Never commit real credentials or expose SUPABASE_SECRET_KEY to browser code.
